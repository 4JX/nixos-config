+bool llama_model::mmap_advise(enum llama_mmap_advice advice) {
+    bool ok = !pimpl->mappings.empty();
+    for (auto & mapping : pimpl->mappings) {
+        ok = mapping->advise(advice) && ok;
+    }
+    return ok;
