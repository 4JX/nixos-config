index 56df61d..14a49a3 100644
--- a/src/llama-mmap.cpp
+++ b/src/llama-mmap.cpp
@@ -683,6 +683,46 @@
 size_t llama_mmap::size() const { return pimpl->size; }
 void * llama_mmap::addr() const { return pimpl->addr; }
 
+bool llama_mmap::advise(enum llama_mmap_advice advice) {
+#ifdef _POSIX_MAPPED_FILES
+    int posix_advice;
+    const char * name;
+    switch (advice) {
+        case LLAMA_MMAP_ADVICE_NORMAL:
+            posix_advice = POSIX_MADV_NORMAL;
+            name = "POSIX_MADV_NORMAL";
+            break;
+        case LLAMA_MMAP_ADVICE_RANDOM:
+            posix_advice = POSIX_MADV_RANDOM;
+            name = "POSIX_MADV_RANDOM";
+            break;
+        case LLAMA_MMAP_ADVICE_SEQUENTIAL:
+            posix_advice = POSIX_MADV_SEQUENTIAL;
+            name = "POSIX_MADV_SEQUENTIAL";
+            break;
+        default:
+            return false;
+    }
+
+    bool ok = true;
+    for (const auto & frag : pimpl->mapped_fragments) {
+        const int err = posix_madvise(
+                (char *) pimpl->addr + frag.first,
+                frag.second - frag.first,
+                posix_advice);
+        if (err != 0) {
+            LLAMA_LOG_WARN("warning: posix_madvise(.., %s) failed for mapped fragment "
+                    "[%zu, %zu): %s\n", name, frag.first, frag.second, strerror(err));
+            ok = false;
+        }
+    }
+    return ok;
+#else
+    (void) advice;
+    return false;
+#endif
+}
+
 void llama_mmap::unmap_fragment(size_t first, size_t last) { pimpl->unmap_fragment(first, last); }
 
